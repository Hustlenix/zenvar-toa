# Copy this file to `.env` (same folder) and fill in the real values.
# The `service_role` key is a SECRET — never commit the real `.env`.
# Find both values in Supabase dashboard > Project Settings > API.

# Publishable URL of your Supabase project
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET key with full database access — local admin use ONLY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
